    {
      "id": "angular-kinematics",
      "title": "Cinematica angular",
      "expressionLatex": "\\omega(t)=\\omega_0+\\alpha t,\\quad \\theta(t)=\\theta_0+\\omega_0t+\\frac{1}{2}\\alpha t^2",
