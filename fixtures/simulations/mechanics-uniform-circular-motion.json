      "min": 0.1,
      "max": 8,
      "step": 0.05,
      "defaultValue": 1.8
    },
    {
      "id": "initialAngleDegrees",
      "label": "Angulo inicial",
      "unit": "deg",
      "kind": "number",
      "min": -180,
      "max": 180,
      "step": 1,
      "defaultValue": 0
