  "formulas": [
    {
      "id": "linear-momentum",
      "title": "Momento linear total",
      "expressionLatex": "\\vec p=m_1\\vec v_1+m_2\\vec v_2",
      "description": "Soma o momento dos dois corpos antes e depois do impacto.",
      "variables": [
        { "symbol": "\\vec p", "label": "momento linear", "unit": "kg m/s" },
        { "symbol": "m", "label": "massa", "unit": "kg" },
        { "symbol": "\\vec v", "label": "velocidade", "unit": "m/s" }
      ],
      "usedWhen": "Usar para comparar o estado total do sistema isolado.",
      "notUsedWhen": "Nao representa sistemas com forcas externas importantes durante o contato.",
      "parameterIds": ["massOneKilograms", "massTwoKilograms"],
      "sampleFields": [
        "momentumKilogramMetersPerSecond",
        "momentumXKilogramMetersPerSecond",
        "momentumZKilogramMetersPerSecond"
      ],
      "relatedChartIds": ["momentum"],
      "relatedVectorIds": ["momentum"]
    },
    {
      "id": "restitution",
      "title": "Coeficiente de restituicao",
      "expressionLatex": "e=-\\frac{v'_{2n}-v'_{1n}}{v_{2n}-v_{1n}}",
      "description": "Controla quanto da velocidade relativa normal retorna apos o contato.",
      "variables": [
        { "symbol": "e", "label": "coeficiente de restituicao" },
        { "symbol": "v_n", "label": "velocidade normal", "unit": "m/s" }
      ],
      "usedWhen": "Usar em colisoes de poucos corpos quando o contato pode ser resumido por um impulso normal.",
      "notUsedWhen": "Nao descreve esmagamento, giro ou atrito de contato.",
      "parameterIds": ["coefficientOfRestitution"],
      "sampleFields": ["speedMetersPerSecond", "secondarySpeedMetersPerSecond"],
      "relatedChartIds": ["velocity"]
    },
    {
      "id": "impulse",
      "title": "Impulso no contato",
      "expressionLatex": "J=\\frac{(1+e)(v_{1n}-v_{2n})}{1/m_1+1/m_2}",
      "description": "Calcula o impulso normal que altera as velocidades no instante da colisao.",
      "variables": [
        { "symbol": "J", "label": "impulso", "unit": "N s" }
      ],
      "usedWhen": "Usar no instante em que a distancia entre os centros chega ao contato.",
      "notUsedWhen": "Nao vale antes do contato nem para contatos longos com forcas variaveis.",
      "parameterIds": [
        "massOneKilograms",
        "massTwoKilograms",
        "coefficientOfRestitution"
      ],
      "sampleFields": ["impulseNewtonSeconds"],
      "relatedChartIds": ["momentum"],
      "relatedVectorIds": ["impulse"]
    },
    {
      "id": "collision-energy",
      "title": "Energia cinetica da colisao",
      "expressionLatex": "K=\\frac{1}{2}m_1v_1^2+\\frac{1}{2}m_2v_2^2",
      "description": "Mostra a energia cinetica total e a perda quando a colisao e inelastica.",
      "variables": [
        { "symbol": "K", "label": "energia cinetica", "unit": "J" }
      ],
      "usedWhen": "Usar para distinguir colisao elastica de inelastica.",
      "notUsedWhen": "Nao inclui energia interna detalhada dos corpos.",
      "parameterIds": [
        "massOneKilograms",
        "massTwoKilograms",
        "coefficientOfRestitution"
      ],
      "sampleFields": ["kineticEnergyJoules", "kineticEnergyLostJoules"],
      "relatedChartIds": ["energy"]
    }
